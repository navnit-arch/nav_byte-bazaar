namespace AzureIntelligentSupplyChain.Modules.CompanyManagement.Application.Mappings;
namespace AzureIntelligentSupplyChain.Modules.CompanyManagement.Application.Mappings;

/// <summary>
/// AutoMapper profile for Company module.
/// </summary>
public class CompanyMappingProfile : Profile
{
    public CompanyMappingProfile()
    {
        // Address mappings
        CreateMap<Address, AddressDto>().ReverseMap();

        // Contact info mappings
        CreateMap<ContactInfo, ContactInfoDto>().ReverseMap();

        // Bank account mappings
        CreateMap<BankAccount, BankAccountDto>().ReverseMap();

        // Company mappings
        CreateMap<Company, CompanyDto>()
            .ForMember(dest => dest.Status, opt => opt.MapFrom(src => (int)src.Status))
            .ForMember(dest => dest.CompanyType, opt => opt.MapFrom(src => (int)src.CompanyType));

        CreateMap<CreateCompanyDto, Company>()
            .ForMember(dest => dest.Id, opt => opt.Ignore())
            .ForMember(dest => dest.CreatedAt, opt => opt.Ignore())
            .ForMember(dest => dest.CreatedBy, opt => opt.Ignore())
            .ForMember(dest => dest.UpdatedAt, opt => opt.Ignore())
            .ForMember(dest => dest.UpdatedBy, opt => opt.Ignore())
            .ForMember(dest => dest.IsDeleted, opt => opt.Ignore())
            .ForMember(dest => dest.DeletedAt, opt => opt.Ignore())
            .ForMember(dest => dest.Version, opt => opt.Ignore())
            .ForMember(dest => dest.Status, opt => opt.MapFrom(_ => CompanyStatus.Active))
            .ForMember(dest => dest.CompanyType, opt => opt.MapFrom(src => (CompanyType)src.CompanyType))
            .ForMember(dest => dest.Headquarters, opt => opt.MapFrom(src => 
                src.Headquarters == null ? null : new Address(
                    src.Headquarters.Street,
                    src.Headquarters.City,
                    src.Headquarters.State,
                    src.Headquarters.PostalCode,
                    src.Headquarters.Country)))
            .ForMember(dest => dest.Contact, opt => opt.MapFrom(src => 
                src.Contact == null ? null : new ContactInfo(
                    src.Contact.Email,
                    src.Contact.Phone,
                    src.Contact.Website)))
            .ForMember(dest => dest.BankAccounts, opt => opt.MapFrom(_ => new List<BankAccount>()));
    }
}
